# Google Gemini API key used to drive the trip-planning agent loop
# Get one (free tier) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Foursquare Places API key (restaurants + attractions)
# Get one at https://location.foursquare.com/developer/
FOURSQUARE_API_KEY=

# Duffel API key (flights) -- free test-mode signup, no travel-agency accreditation needed
# Get one at https://duffel.com/ -> Developers -> Access tokens (use a "test" token)
DUFFEL_API_KEY=

PORT=3001
